# Copy to .env and fill in. Never commit .env.
# Output of `bun run create-setup` at the repository root. Back it up: losing it locks out every account.
OPAQUE_SERVER_SETUP=
# Any random string of at least 32 characters, for example `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=file:./dev.db
